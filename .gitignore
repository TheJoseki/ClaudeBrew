
# Claude Code worktrees — isolated working trees created by the `worktree` skill.
# Each worktree has its own working files that must not be tracked by the parent.
# Python coverage artifacts
**/.coverage
*.pyc
.claude/worktrees/
.coverage
__pycache__/

# Local planning artifacts (plans + reports) — kept on disk, not committed
/plans/

# Ephemeral runtime artifacts written by the lifecycle hooks (derived, not source)
.claude/sdlc-index.json
.claude/compact-checkpoint.md
.claude/.smoke-*

# Dogfood build output — `claudebrew install --dev` copies the claude/ payload
# here so a session in this repo loads the skills + fires the hooks. Source of
# truth is claude/; these installed copies are derived. NOTE: .claude/settings.json
# stays TRACKED (contributors get the harness on checkout); only the payload
# subdirs below are ignored, enumerated positively so a sibling worktree is never touched.
.claude/skills/
.claude/agents/
.claude/hooks/
.claude/rules/
.claude/schemas/
.claude/docs/
