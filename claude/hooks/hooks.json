{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/protect-files.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/protect-files.py\" read"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/guard-bash.py\""
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/guard-webfetch.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/compact-context-saver.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/session-init.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CBR_ROOT}}/hooks/subagent-context.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CBR_ROOT}}/hooks/post-edit-reminder.sh\""
          }
        ]
      }
    ]
  }
}
